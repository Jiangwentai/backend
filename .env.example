POSTGRES_DB=market_data
POSTGRES_USER=market_data
POSTGRES_PASSWORD=change-me
QDB_HOST=127.0.0.1
QDB_PORT=9000
QDB_HTTP_PORT=9000
QDB_PG_PORT=8812
QDB_METRICS_PORT=9003
QDB_SF_DIR=./data/qwp-spool
MAX_BATCH_ROWS=500
MAX_BATCH_LATENCY_MS=20
INGRESS_QUEUE_CAPACITY=1048576
PERSISTENCE_QUEUE_CAPACITY=1048576
LIVE_QUEUE_CAPACITY=65536
ZMQ_PUB_ENDPOINT=tcp://127.0.0.1:5556
# Bounded per-peer message buffers; successful PUB send does not prove delivery.
ZMQ_SNDHWM=1000
ZMQ_RCVHWM=1000
ZMQ_SUB_ENDPOINT=tcp://127.0.0.1:5556
QDB_HTTP_URL=http://127.0.0.1:9000
API_PORT=8000
WEBSOCKET_QUEUE_CAPACITY=128
LIVE_STALE_AFTER_SECONDS=5
SYNTHETIC_RATE=10000
MARKET_DATA_SOURCE=synthetic
SYNTHETIC_PROVIDER_ENABLED=true
CTP_PROVIDER_ENABLED=false
AKSHARE_ENABLED=false
AKSHARE_MAX_CONCURRENCY=2
AKSHARE_MIN_INTERVAL_MS=500
AKSHARE_MAX_ATTEMPTS=3
AKSHARE_RAW_ROOT=/var/lib/market-data/raw
AKSHARE_SYMBOLS=
AKSHARE_DAILY_INTERVAL_SECONDS=86400
AKSHARE_INTRADAY_REFRESH_ENABLED=false
AKSHARE_INTRADAY_REFRESH_INTERVAL_SECONDS=300
AKSHARE_REALTIME_ENABLED=false
AKSHARE_QUOTE_INSTRUMENTS=
AKSHARE_QUOTE_POLL_INTERVAL_SECONDS=5
AKSHARE_QUOTE_REQUEST_TIMEOUT_SECONDS=10
AKSHARE_QUOTE_MAX_CONCURRENCY=2
AKSHARE_QUOTE_BATCH_SIZE=20
AKSHARE_QUOTE_STALE_AFTER_SECONDS=15
AKSHARE_REALTIME_PERSIST=false
AKSHARE_ZMQ_PUB_ENDPOINT=tcp://0.0.0.0:5557
AKSHARE_ZMQ_SUB_ENDPOINT=
PROVIDER_SELECTION_MODE=explicit
PROVIDER_PREFERENCE=ctp,ibkr,synthetic,akshare
PROVIDER_FALLBACK_ENABLED=false
PROVIDER_ALLOW_STALE=false
PROVIDER_DISCREPANCY_BPS=20
# CTP secrets must be supplied by the runtime environment; never commit real values.
CTP_FRONT_ADDRESS=tcp://example.invalid:12345
CTP_BROKER_ID=replace-me
CTP_USER_ID=replace-me
CTP_PASSWORD=replace-me
CTP_APP_ID=
CTP_AUTH_CODE=
CTP_FLOW_PATH=./data/ctp-flow/
CTP_AUTHENTICATION_REQUIRED=false
LOG_LEVEL=info
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://market_data:change-me@127.0.0.1:5432/market_data
POSTGRES_TIMEOUT_SECONDS=5
ARCHIVE_ROOT=./data/market
