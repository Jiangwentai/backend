POSTGRES_DB=market_data
POSTGRES_USER=market_data
POSTGRES_PASSWORD=change-me
QDB_HOST=127.0.0.1
QDB_PORT=9000
QDB_HTTP_PORT=9000
QDB_PG_PORT=8812
QDB_METRICS_PORT=9003
QDB_SF_DIR=./data/qwp-spool
MAX_BATCH_ROWS=500
MAX_BATCH_LATENCY_MS=20
INGRESS_QUEUE_CAPACITY=1048576
PERSISTENCE_QUEUE_CAPACITY=1048576
LIVE_QUEUE_CAPACITY=65536
ZMQ_PUB_ENDPOINT=tcp://127.0.0.1:5556
ZMQ_SUB_ENDPOINT=tcp://127.0.0.1:5556
QDB_HTTP_URL=http://127.0.0.1:9000
API_PORT=8000
WEBSOCKET_QUEUE_CAPACITY=128
LIVE_STALE_AFTER_SECONDS=5
SYNTHETIC_RATE=10000
MARKET_DATA_SOURCE=synthetic
# CTP secrets must be supplied by the runtime environment; never commit real values.
CTP_FRONT_ADDRESS=tcp://example.invalid:12345
CTP_BROKER_ID=replace-me
CTP_USER_ID=replace-me
CTP_PASSWORD=replace-me
CTP_APP_ID=
CTP_AUTH_CODE=
CTP_FLOW_PATH=./data/ctp-flow/
CTP_AUTHENTICATION_REQUIRED=false
LOG_LEVEL=info
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://market_data:change-me@127.0.0.1:5432/market_data
POSTGRES_TIMEOUT_SECONDS=5
ARCHIVE_ROOT=./data/market
