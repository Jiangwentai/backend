namespace market_data::ctp {
std::optional<MarketTick> normalize(const DepthSnapshot&s,std::int64_t recv_ns,std::chrono::system_clock::time_point recv,const ProducerId&id,std::uint64_t seq,std::string_view fallback_exchange) noexcept{
 try{const auto exchange=s.exchange.view().empty()?fallback_exchange:s.exchange.view();const auto instrument=s.instrument.view();if(instrument.empty()||exchange.empty()||s.trading_day.view().empty()||exchange.size()+instrument.size()+1>=64)return std::nullopt;MarketTick t;t.provider=ProviderId::ctp;t.event_type=MarketEventType::quote_snapshot;t.quality=DataQuality::realtime;t.recv_ts_ns=recv_ns;t.event_ts_us=normalize_ctp_event_ts_us(s.action_day.view(),s.update_time.view(),s.update_millisec,recv);t.producer_id=id;t.seq=seq;t.instrument=s.instrument;t.exchange.assign(exchange);std::array<char,64> canonical{};std::copy(exchange.begin(),exchange.end(),canonical.begin());canonical[exchange.size()]='.';std::copy(instrument.begin(),instrument.end(),canonical.begin()+static_cast<std::ptrdiff_t>(exchange.size()+1));t.instrument_id.assign(std::string_view{canonical.data(),exchange.size()+instrument.size()+1});t.trading_day=s.trading_day;t.action_day=s.action_day;t.last_price=normalize_price(s.last_price);t.volume=s.volume;t.turnover=s.turnover;t.open_interest=s.open_interest;t.upper_limit_price=normalize_price(s.upper_limit_price);t.lower_limit_price=normalize_price(s.lower_limit_price);for(std::size_t i=0;i<5;++i){t.bid_price[i]=normalize_price(s.bid_price[i]);t.ask_price[i]=normalize_price(s.ask_price[i]);t.bid_volume[i]=s.bid_volume[i];t.ask_volume[i]=s.ask_volume[i];}return t;}catch(...){return std::nullopt;}
}
IngressResult normalize_and_enqueue(const DepthSnapshot&s,std::int64_t recv_ns,std::chrono::system_clock::time_point recv,ProducerIdentity&identity,SpscQueue<MarketTick>&queue,std::string_view fallback_exchange)noexcept{auto tick=normalize(s,recv_ns,recv,identity.id(),identity.next_seq(),fallback_exchange);if(!tick)return IngressResult::invalid;return queue.try_push(*tick)?IngressResult::accepted:IngressResult::queue_full;}
IngressResult normalize_and_publish(const DepthSnapshot&s,std::int64_t recv_ns,std::chrono::system_clock::time_point recv,ProducerIdentity&identity,IMarketEventSink&sink,std::string_view fallback_exchange)noexcept{auto tick=normalize(s,recv_ns,recv,identity.id(),identity.next_seq(),fallback_exchange);if(!tick)return IngressResult::invalid;return sink.publish(MarketEvent{std::move(*tick)})?IngressResult::accepted:IngressResult::queue_full;}
}
