#include "market_data/live_protocol.hpp"
#include <msgpack.hpp>
#include <stdexcept>
namespace market_data {
std::string live_topic(const MarketTick&t){return std::string(t.exchange.view())+"."+std::string(t.instrument.view());}
std::vector<std::uint8_t> encode_live_tick(const MarketTick&t){msgpack::sbuffer b;msgpack::packer<msgpack::sbuffer>p(b);p.pack_map(19);auto k=[&](const char*s){p.pack(s);};k("schema_version");p.pack(live_schema_version);k("event_ts");p.pack(t.event_ts_us);k("recv_ts");p.pack(t.recv_ts_ns);k("producer_id");p.pack(t.producer_id.view());k("seq");p.pack(t.seq);k("exchange");p.pack(t.exchange.view());k("instrument");p.pack(t.instrument.view());k("trading_day");p.pack(t.trading_day.view());k("action_day");p.pack(t.action_day.view());k("last_price");p.pack(t.last_price);k("volume");p.pack(t.volume);k("turnover");p.pack(t.turnover);k("open_interest");p.pack(t.open_interest);k("upper_limit_price");p.pack(t.upper_limit_price);k("lower_limit_price");p.pack(t.lower_limit_price);k("bid_price");p.pack(t.bid_price);k("bid_volume");p.pack(t.bid_volume);k("ask_price");p.pack(t.ask_price);k("ask_volume");p.pack(t.ask_volume);return{reinterpret_cast<const std::uint8_t*>(b.data()),reinterpret_cast<const std::uint8_t*>(b.data())+b.size()};}
MarketTick decode_live_tick(const std::uint8_t*d,std::size_t n){auto o=msgpack::unpack(reinterpret_cast<const char*>(d),n);std::map<std::string,msgpack::object>m;o.get().convert(m);if(m.at("schema_version").as<std::uint32_t>()!=live_schema_version)throw std::runtime_error("unsupported live schema_version");MarketTick t;t.event_ts_us=m.at("event_ts").as<std::int64_t>();t.recv_ts_ns=m.at("recv_ts").as<std::int64_t>();t.producer_id.assign(m.at("producer_id").as<std::string>());t.seq=m.at("seq").as<std::uint64_t>();t.exchange.assign(m.at("exchange").as<std::string>());t.instrument.assign(m.at("instrument").as<std::string>());t.trading_day.assign(m.at("trading_day").as<std::string>());t.action_day.assign(m.at("action_day").as<std::string>());t.last_price=m.at("last_price").as<double>();t.volume=m.at("volume").as<std::int64_t>();t.turnover=m.at("turnover").as<double>();t.open_interest=m.at("open_interest").as<double>();t.upper_limit_price=m.at("upper_limit_price").as<double>();t.lower_limit_price=m.at("lower_limit_price").as<double>();m.at("bid_price").convert(t.bid_price);m.at("bid_volume").convert(t.bid_volume);m.at("ask_price").convert(t.ask_price);m.at("ask_volume").convert(t.ask_volume);return t;}
}
