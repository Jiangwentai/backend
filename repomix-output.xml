#include "market_data/zmq_publisher.hpp"
#include "market_data/live_protocol.hpp"
#include <zmq.hpp>
#include <spdlog/spdlog.h>
namespace market_data {ZmqPublisher::~ZmqPublisher(){request_stop();join();}void ZmqPublisher::start(){thread_=std::thread(&ZmqPublisher::run,this);}void ZmqPublisher::request_stop()noexcept{stop_=true;}void ZmqPublisher::join(){if(thread_.joinable())thread_.join();}void ZmqPublisher::run(){try{zmq::context_t context{1};zmq::socket_t socket{context,zmq::socket_type::pub};socket.set(zmq::sockopt::linger,0);socket.bind(endpoint_);MarketTick t;while(!stop_||!queue_.empty()){if(!queue_.try_pop(t)){std::this_thread::yield();continue;}auto topic=live_topic(t);auto body=encode_live_tick(t);try{const auto topic_result=socket.send(zmq::buffer(topic),zmq::send_flags::sndmore|zmq::send_flags::dontwait);if(!topic_result){++failures_;spdlog::warn("zeromq_topic_send_would_block");continue;}const auto body_result=socket.send(zmq::buffer(body),zmq::send_flags::dontwait);if(body_result)++sent_;else{++failures_;spdlog::warn("zeromq_payload_send_would_block");}}catch(const zmq::error_t&e){++failures_;spdlog::error("zeromq_send_failure error={}",e.what());}}}catch(const std::exception&e){++failures_;spdlog::critical("zeromq_publisher_failure error={}",e.what());}}}
