services:
  questdb:
    image: questdb/questdb:9.4.3
    ports:
      - "${QDB_HTTP_PORT:-9000}:9000"
      - "${QDB_PG_PORT:-8812}:8812"
      - "${QDB_METRICS_PORT:-9003}:9003"
    volumes:
      - questdb-data:/var/lib/questdb
    healthcheck:
      test: ["CMD", "curl", "-fsSG", "--data-urlencode", "query=SELECT 1", "http://localhost:9000/exec"]
      interval: 2s
      timeout: 2s
      retries: 30
  questdb-init:
    image: curlimages/curl:8.15.0
    depends_on:
      questdb:
        condition: service_healthy
    volumes:
      - ./sql/questdb:/schema:ro
    entrypoint: ["/bin/sh", "-ec"]
    command: ["for file in /schema/*.sql; do curl -fsS -G --data-urlencode query@$$file http://questdb:9000/exec; done"]
    restart: "no"
  postgres:
    image: postgres:17.6-bookworm
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-market_data}
      POSTGRES_USER: ${POSTGRES_USER:-market_data}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-dev-only-password}
    ports: ["${POSTGRES_PORT:-5432}:5432"]
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./sql/postgresql:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 2s
      timeout: 2s
      retries: 30
  api:
    build:
      context: .
      dockerfile: docker/api.Dockerfile
    environment:
      ZMQ_RCVHWM: ${ZMQ_RCVHWM:-1000}
      ZMQ_SUB_ENDPOINT: ${ZMQ_SUB_ENDPOINT:-tcp://host.docker.internal:5556}
      AKSHARE_ZMQ_SUB_ENDPOINT: ${AKSHARE_ZMQ_SUB_ENDPOINT:-}
      AKSHARE_QUOTE_STALE_AFTER_SECONDS: ${AKSHARE_QUOTE_STALE_AFTER_SECONDS:-15}
      PROVIDER_SELECTION_MODE: ${PROVIDER_SELECTION_MODE:-explicit}
      PROVIDER_PREFERENCE: ${PROVIDER_PREFERENCE:-ctp,ibkr,synthetic,akshare}
      PROVIDER_FALLBACK_ENABLED: ${PROVIDER_FALLBACK_ENABLED:-false}
